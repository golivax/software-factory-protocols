{
  "name": "duplicate-code-remover",
  "version": "0.1.0",
  "min_engine_version": "11.1.0",
  "triggers": [
    {
      "on": "schedule",
      "command": "start"
    },
    {
      "on": "workflow_dispatch",
      "command": "start"
    }
  ],
  "states": [
    {
      "id": "detect",
      "kind": "agent",
      "label": "detect (C++ duplication scan)",
      "workflow": "duplicate-code-remover-detect-agent",
      "evidence": "detect.evidence.schema.json",
      "max_iterations": 2,
      "params": {
        "min_locations": 2,
        "severities": [
          "high",
          "medium",
          "low"
        ]
      },
      "checks": [
        {
          "run": "evidence-wellformed",
          "on_fail": "iterate"
        },
        {
          "run": "anchored-to-real-code",
          "on_fail": "iterate"
        }
      ],
      "next": "file-issues"
    },
    {
      "id": "file-issues",
      "kind": "code",
      "_note": "Files one issue per duplication pattern and comments /impl-feature-auto on each, from its own microVM with its job token (issues: write). params.max_patterns caps how many patterns are filed per run.",
      "inputs": [
        {
          "from": "detect",
          "as": "evidence"
        }
      ],
      "next": "done",
      "workflow": "file-issues",
      "params": {
        "max_patterns": 3
      }
    }
  ]
}
