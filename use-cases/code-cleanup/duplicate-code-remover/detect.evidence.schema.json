{
  "title": "duplicate-code-remover detect evidence",
  "type": "object",
  "required": ["scanned", "patterns"],
  "additionalProperties": false,
  "properties": {
    "scanned": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Files/symbols the agent actually examined (proves it read the code; required, non-empty, even when patterns is empty)."
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "severity", "rationale", "locations"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "rationale": { "type": "string" },
          "locations": {
            "type": "array",
            "description": "At least two (the evidence-wellformed check settles the count).",
            "items": {
              "type": "object",
              "required": ["path", "start_line", "end_line", "existing_code"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string" },
                "start_line": { "type": "integer" },
                "end_line": { "type": "integer" },
                "existing_code": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
