#!/usr/bin/env python3
"""Real diff-parsing expander for dyn-fanout-stub (and, verbatim, code-review-ocr).
Emits one item per changed file: {"path","diff"}. OCR-style pre-filters skip
binary, vendored/generated, and oversized-diff files, and a file with no hunk
(a pure rename, a mode change).

It reads the MR diff the factory already fetched, $CHECK_CTX/diff.patch: an
expander runs in an expand round (engine 11.0.0, #211) with the same ground
truth as a check, so it fetches nothing itself.

Modes:
  $CHECK_CTX/diff.patch non-empty -> parse it.
  the factory could not compute it (pr.json names the MR, no base_sha)
                                  -> exit 1: the run fails, never "no legs".
  otherwise                       -> no items (a PR with no diff has no files).

Thresholds come from EXPAND_PARAMS (JSON of the node's `expand` object) with defaults.
"""
import json, os, re

VENDOR_RE = re.compile(
    r'(^|/)(vendor|node_modules|dist|build|third_party|\.venv)(/|$)'
    r'|\.min\.(js|css)$|(^|/)(go\.sum|package-lock\.json|uv\.lock|yarn\.lock)$'
)

def _params():
    try:
        return json.loads(os.environ.get("EXPAND_PARAMS", "") or "{}")
    except (json.JSONDecodeError, ValueError):
        return {}

def _load_diff():
    ctx = os.environ.get("CHECK_CTX", "")
    try:
        with open(os.path.join(ctx, "pr.json")) as f:
            pr = json.load(f)
    except (OSError, ValueError):
        pr = {}
    if pr.get("number") and not pr.get("base_sha"):
        raise SystemExit("expand-files: the factory could not compute the MR's diff "
                         "(pr.json names no base_sha)")
    try:
        with open(os.path.join(ctx, "diff.patch")) as f:
            return f.read()
    except OSError:
        return ""

def _split_files(diff_text):
    """Yield (path, chunk) per `diff --git a/<p> b/<p>` header."""
    chunks = re.split(r'(?m)^(?=diff --git )', diff_text)
    for chunk in chunks:
        if not chunk.startswith("diff --git "):
            continue
        m = re.match(r'diff --git a/(.+?) b/(.+)', chunk.splitlines()[0])
        if not m:
            continue
        yield m.group(2).strip(), chunk

def _is_binary(chunk):
    return "\nBinary files " in ("\n" + chunk) or chunk.count("GIT binary patch")

def _has_hunks(chunk):
    """A pure rename or a mode change carries no line to review."""
    return "\n@@ " in chunk

def _diff_lines(chunk):
    return sum(1 for ln in chunk.splitlines()
               if (ln.startswith("+") or ln.startswith("-")) and not ln.startswith(("+++", "---")))

def main():
    max_diff_lines = int(_params().get("max_diff_lines", 1500))
    diff = _load_diff()
    items = []
    for path, chunk in _split_files(diff):
        if _is_binary(chunk) or not _has_hunks(chunk):
            continue
        if VENDOR_RE.search(path):
            continue
        if _diff_lines(chunk) > max_diff_lines:
            continue
        items.append({"path": path, "diff": chunk})
    print(json.dumps({"items": items}))

if __name__ == "__main__":
    main()
