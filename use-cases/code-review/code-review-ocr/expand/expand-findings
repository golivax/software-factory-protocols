#!/usr/bin/env python3
"""OCR per-finding expander. Reads the file leg's main-review evidence (the
`findings` fork's declared input `main-review`, at
$CHECK_CTX/inputs/main-review.json) and emits one item per candidate finding:
{finding_id, path, existing_code, side, line[,start_line], comment}.
id_from: $.finding_id. Fails loud when the evidence is missing or malformed."""
import json, os

def _load():
    p = os.path.join(os.environ.get("CHECK_CTX", ""), "inputs", "main-review.json")
    try:
        with open(p) as f:
            return json.load(f)
    except (OSError, ValueError) as e:
        raise SystemExit(f"expand-findings: no main-review evidence at {p!r}: {e}")

def main():
    ev = _load()
    items = []
    for fobj in ev.get("files", []):
        path = fobj.get("path", "")
        for fi in fobj.get("findings", []):
            it = {"finding_id": fi["finding_id"], "path": path,
                  "existing_code": fi.get("existing_code", ""), "side": fi.get("side", "RIGHT"),
                  "line": fi.get("line"), "comment": fi.get("comment", "")}
            if fi.get("start_line") is not None:
                it["start_line"] = fi["start_line"]
            items.append(it)
    print(json.dumps({"items": items}))

if __name__ == "__main__":
    main()
