{
  "name": "recover-mental-model",
  "version": "1.0.0",
  "min_engine_version": "7.1.0",
  "triggers": [
    {
      "on": "manual",
      "command": "start"
    }
  ],
  "states": [
    {
      "id": "recover",
      "kind": "fork",
      "label": "recover mental model",
      "branches": [
        {
          "id": "legion",
          "kind": "agent",
          "label": "codebase overview",
          "workflow": "mm-legion-agent",
          "outputs": true,
          "evidence": "legion.evidence.schema.json",
          "max_iterations": 1,
          "checks": [
            {
              "run": "legion-artifacts",
              "on_fail": "block"
            }
          ]
        },
        {
          "id": "codeset",
          "kind": "agent",
          "label": "per-file context and co-change analysis",
          "workflow": "mm-codeset-agent",
          "outputs": true,
          "evidence": "codeset.evidence.schema.json",
          "max_iterations": 1,
          "checks": [
            {
              "run": "codeset-artifacts",
              "on_fail": "block"
            }
          ]
        },
        {
          "id": "ubiquitous-language",
          "kind": "agent",
          "label": "domain modelling",
          "workflow": "mm-ubiquitous-language-agent",
          "outputs": true,
          "evidence": "ubiquitous-language.evidence.schema.json",
          "max_iterations": 1,
          "checks": [
            {
              "run": "ubiquitous-language-present",
              "on_fail": "block"
            }
          ]
        },
        {
          "id": "socratic",
          "kind": "sequence",
          "label": "architecture decision record",
          "states": [
            {
              "id": "phase1",
              "kind": "agent",
              "workflow": "mm-socratic-phase1-agent",
              "outputs": true,
              "evidence": "socratic-phase1.evidence.schema.json",
              "max_iterations": 1,
              "checks": [
                {
                  "run": "socratic-phase1-present",
                  "on_fail": "block"
                }
              ]
            },
            {
              "id": "answering",
              "kind": "agent",
              "workflow": "mm-socratic-answering-agent",
              "outputs": true,
              "evidence": "socratic-answering.evidence.schema.json",
              "max_iterations": 1,
              "inputs": [
                {
                  "from": "phase1",
                  "as": "tree"
                }
              ],
              "checks": [
                {
                  "run": "socratic-answering-present",
                  "on_fail": "block"
                }
              ]
            },
            {
              "id": "phase2",
              "kind": "agent",
              "workflow": "mm-socratic-phase2-agent",
              "outputs": true,
              "evidence": "socratic-phase2.evidence.schema.json",
              "max_iterations": 1,
              "inputs": [
                {
                  "from": "phase1",
                  "as": "tree"
                },
                {
                  "from": "answering",
                  "as": "answers"
                }
              ],
              "checks": [
                {
                  "run": "socratic-docs-present",
                  "on_fail": "block"
                }
              ]
            }
          ]
        }
      ],
      "next": "join"
    },
    {
      "id": "join",
      "kind": "join",
      "of": "recover",
      "next": "combine"
    },
    {
      "id": "combine",
      "kind": "code",
      "script": "push-mental-model",
      "_note": "Force-pushes the orphan _mental_model branch and downloads leg artifacts, so it needs a write-capable token + the target remote. Everything not listed here is withheld (lib.hook_base_env).",
      "env": [
        "PUBLISH_TOKEN",
        "GH_TOKEN",
        "MM_TARGET_REMOTE",
        "PR_HEAD_SHA"
      ],
      "inputs": [
        {
          "from": "legion",
          "as": "legion"
        },
        {
          "from": "codeset",
          "as": "codeset"
        },
        {
          "from": "ubiquitous-language",
          "as": "ubiquitous-language"
        },
        {
          "from": "socratic",
          "as": "socratic"
        }
      ],
      "next": "done"
    }
  ]
}
